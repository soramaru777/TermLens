# サーバーポート
PORT=8080

# 共有アクセストークン(未設定なら認証なし = ローカル開発用)
AUTH_TOKEN=

# STTプロバイダ: mock | deepgram
STT_PROVIDER=mock

# Deepgram APIキー (STT_PROVIDER=deepgram のとき必須)
DEEPGRAM_API_KEY=

# Anthropic APIキー (未設定なら SDK の既定解決: 環境変数 / ant auth プロファイル)
ANTHROPIC_API_KEY=

# 用語抽出モデル: claude-opus-4-8 (高精度・既定) | claude-haiku-4-5 (安価・高速)
ANTHROPIC_MODEL=claude-opus-4-8
