# サーバーポート
PORT=8080

# 共有アクセストークン(未設定なら認証なし = ローカル開発用)
# 本番では openssl rand -hex 16 などで生成した128bit以上のランダム値を設定する
AUTH_TOKEN=

# STTプロバイダ: mock | deepgram
STT_PROVIDER=mock

# Deepgram APIキー (STT_PROVIDER=deepgram のとき必須)
DEEPGRAM_API_KEY=

# OpenAI APIキー (未設定なら SDK の既定解決: 環境変数)
OPENAI_API_KEY=

# 用語抽出・清書に使うモデル
# gpt-5.6-luna (安価・高速・既定) | gpt-5.6-terra | gpt-5.6-sol
LLM_MODEL=gpt-5.6-luna

# 1カードの検証で許す web 検索の回数 (既定 5)。0 で上限なし
# 上限値は暫定。決めるための計測は上限を外して回すこと:
#   MAX_WEB_SEARCHES=0 EVAL_WITH_VERIFY=1 npm run eval:llm
MAX_WEB_SEARCHES=5
